// ------------- ODP Test harness Jenkins Pipeline -------------

// Following variables store the values of the selected COMPONENTS & Kerberos.
def clustername = '${params.cluster_name}'
def servername = '${params.Ambari_server_IP}'
def username = '${params.user_name}'

def components = '${params.COMPONENTS}'
def kerberos = '${params.KERBEROS}'
pipeline {
    agent {
        label "buildbox03" 
    }
    parameters {

            string(
                name: 'user_name',
                defaultValue: '',
                description: ''
                )

            string(
                name: 'Ambari_server_IP',
                defaultValue: '',
                description: ''
                )


            string(
                name: 'cluster_name',
                defaultValue: '',
                description: ''
                )


            string(
                name: 'cluster_nodes',
                defaultValue: '',
                description: ''
                )

            extendedChoice(
                name: 'COMPONENTS',
                defaultValue: '',
                description: '',
                value: 'HDFS,YARN,AMBARI,ZOOKEEPER,HBASE,HIVE,RANGER,SPARK3,SPARK2,KAFKA,OOZIE,HUE,KNOX,IMPALA,ZEPPELIN,AIRFLOW,DRUID,TPCDS,TPCH',
                type: 'PT_CHECKBOX',
                visibleItemCount: 19

                )


            extendedChoice(
                name: 'Python',
                description: '',
                multiSelectDelimiter: ',',
                quoteValue: false,
                saveJSONParameterToFile: false,
                type: 'PT_RADIO',
                visibleItemCount: 2,
                defaultValue: '',
                value: '2,3'
                )


            string(
                name: 'data_size',
                defaultValue: '',
                description: 'for tpcds,tpch'
                )


            string(
                name: 'data_type',
                defaultValue: '',
                description: 'for tpcds,tpch'
                )

            extendedChoice(
                name: 'KERBEROS',
                defaultValue: 'NO',
                description: '',
                value: 'YES,NO',
                type: 'PT_RADIO',
                visibleItemCount: 2

                )


            extendedChoice(
                name: 'OS_TYPE',
                defaultValue: 'NO',
                description: '',
                value: 'CENTOS7,RHEL8,UBUNTU20',
                type: 'PT_RADIO',
                visibleItemCount: 3

                )

            string(
                name: 'ssh_port',
                defaultValue: '22',
                description: 'ssh port'
                )
                
            text(
                name: 'keyfile',
