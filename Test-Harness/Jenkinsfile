                    }
                    }
                }
            }    
        }
        
        stage("kafka") {
            steps{
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    if (params.COMPONENTS.contains('KAFKA')) {
                        sh 'echo Kafka test bench'

                        sh "echo ${params.Ambari_server_IP} "

                        if (params.Python.contains('2')) {

                            sh "cd playbooks/ && ansible-playbook kafka1_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name} krb=${params.KERBEROS}'"

                        }
                        if (params.Python.contains('3')) {

                            sh "virtualenv -p /usr/bin/python3 ~/ansible; source ~/ansible/bin/activate && cd playbooks/ && ansible-playbook kafka1_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name} krb=${params.KERBEROS}'"

