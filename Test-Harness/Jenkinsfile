                        sh "cd playbooks/ && ansible-playbook tpch_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name} Ambari_server_IP=${params.Ambari_server_IP} data_type=${params.data_type} data_size=${params.data_size} krb=${params.KERBEROS}'"
