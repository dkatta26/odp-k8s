                    }
                    }
                }
            }
        }

        stage("spark3") {
            steps{
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    if (params.COMPONENTS.contains('SPARK3')) {
                        sh 'echo Spark3 test bench'


                        if (params.Python.contains('2')) {

                            sh "cd playbooks/ && ansible-playbook spark3_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name}'"

                        }
                        if (params.Python.contains('3')) {

                            sh "virtualenv -p /usr/bin/python3 ~/ansible; source ~/ansible/bin/activate && cd playbooks/ && ansible-playbook spark3_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name}'"

                        }
                    }
                    }
                }
            }
        }

        stage("spark2") {
            steps{
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    if (params.COMPONENTS.contains('SPARK2')) {
                        sh 'echo Spark2 test bench'

                        if (params.Python.contains('2')) {

                            sh "cd playbooks/ && ansible-playbook spark2_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name}'"

                        }
                        if (params.Python.contains('3')) {

                            sh "virtualenv -p /usr/bin/python3 ~/ansible; source ~/ansible/bin/activate && cd playbooks/ && ansible-playbook spark2_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name}'"

                        }
                    }
                    }
                }
            }
        }


        stage("airflow") {
            steps{
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    if (params.COMPONENTS.contains('AIRFLOW')) {
                        sh 'echo AIRFLOW '
