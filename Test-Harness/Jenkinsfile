    stages{
        stage("Components to be tested") {
            steps {
                script {
                    def component = params.COMPONENTS.replaceAll('\r\n|\n', ',').trim()
                    sh "echo $component"


                    sh "echo ${params.COMPONENTS}"
                    def component_list = component.split(',')


                    if (params.KERBEROS.contains('YES')) {
                        sh """ echo KERBEROS  """

                    }


                    sh "echo ${component_list}"
                    if (params.COMPONENTS.contains('HBASE')) {
                        sh 'echo HBASE HBASE'
                        sh "echo ${params.Ambari_server_IP} "
                    }


                    sh "echo ${params.KERBEROS}"
                }
            }
        }


        stage("Setting up ssh") {
            steps {
                script {
                    sh "pwd"
                    sh "rm -rf playbooks odp-test-bench && git clone git@bitbucket.org:sehaj_sandhu/odp-test-bench.git"
                    sh "mv odp-test-bench/ansible-acceldata/playbooks ."


                    def keyfile = params.keyfile
                    sh " echo '${keyfile}' > /root/.keys/custom_${params.user_name}_key  "
                    sh " chmod 400 /root/.keys/custom_${params.user_name}_key"


                    if (params.OS_TYPE.contains('CENTOS7')) {

                        sh "echo '[hdp-master01] \nmaster01 ansible_host=${params['Ambari_server_IP'].trim()} ansible_user=root ansible_ssh_private_key_file=\"/root/.keys/custom_${params.user_name}_key\" ansible_port=${params.ssh_port} ' > ${params.user_name}_server"
                        sh "pwd"


                    }
                    if (params.OS_TYPE.contains('UBUNTU20')) {

                        sh "echo '[hdp-master01] \nmaster01 ansible_host=${params['Ambari_server_IP'].trim()} ansible_user=root ansible_ssh_private_key_file=\"/root/.keys/custom_${params.user_name}_key\" ansible_port=${params.ssh_port} ' > ${params.user_name}_server"
                        sh "cd playbooks && bash ansible_pass.sh ../${params.user_name}"
                        sh "pwd"


                    }
                    if (params.OS_TYPE.contains('RHEL8')) {

                        sh "echo '[hdp-master01] \nmaster01 ansible_host=${params['Ambari_server_IP'].trim()} ansible_user=root ansible_ssh_private_key_file=\"/root/.keys/custom_${params.user_name}_key\" ansible_port=${params.ssh_port} ' > ${params.user_name}_server"
                        sh "pwd"
                    }

                    sh "ssh-keygen -R ${params.Ambari_server_IP}"
                    //sh " cd playbooks && pwd && export ANSIBLE_HOST_KEY_CHECKING=False && ansible-playbook -i ../${params.user_name}_server  pwds.yml --extra-vars 'ansible_user=root'  "


                }
            }
        }


        stage("setting up the ODP test bench") {
            steps{
                script {


                        sh "rm -rf odp-test-bench && git clone git@bitbucket.org:sehaj_sandhu/odp-test-bench.git "
                        sh "rm -rf odp-test-bench/odp-test-harness && cd odp-test-bench && git clone git@github.com:acceldata-io/odp-test-harness.git "
                        sh "rm -rf odp-test-bench/spark2 && mkdir odp-test-bench/spark2 && cd odp-test-bench/spark2 && git clone -b SPARK2-test-bench git@github.com:acceldata-io/odp-test-harness.git "
                        sh "scp -i /root/.keys/custom_${params.user_name}_key -r ./odp-test-bench root@${params.Ambari_server_IP}:/root/"
                        sh "cat ${params.user_name}_server"
                        sh "ls odp-test-bench/spark2/odp-test-harness/src/test/groovy/io/ad/odp/tests/"

                        sh "cd playbooks/ && ansible-playbook installer.yml -i ../${params.user_name}_server"


                }
            }
        }


        stage("user creation & permissions") {
            steps{
                script {

                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {



                        sh "pwd"
                        sh "cd playbooks/ && ansible-playbook users.yml -i ../${params.user_name}_server"

                        sh " cd playbooks/ && ansible-playbook ambariconf.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name} node_list=${params.cluster_nodes}'  "

                        sh 'echo user setup'

                        sh "echo ${params.Ambari_server_IP} "


                    }

                }
            }
        }


        stage("kerberos req") {
            steps{
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    if (params.KERBEROS.contains('YES')) {

                            sh 'echo kerberos'
                            sh "echo ${params.Ambari_server_IP} "
                            sh "cd playbooks/ && ansible-playbook common.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name}'"

                    }
                    }
                }
            }
        }


        stage("zookeeper") {
            steps{

                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    if (params.COMPONENTS.contains('ZOOKEEPER')) {

                        sh 'echo ZOOKEEPER ZOOKEEPER'
                        sh "echo ${params.Ambari_server_IP} "
                        sh "cd playbooks/ && ansible-playbook zookeeper_playbook.yml -i ../${params.user_name}_server"


                    }
                    }
                }
            }
        }


