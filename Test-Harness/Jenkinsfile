                    }
                    }
                }
            }
        }



        stage("postrun") {
            steps{
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh "rm -rf ./complete-result"
                    sh "cd playbooks/ && ansible-playbook post_run.yml -i ../${params.user_name}_server"

                }
                }
            }
        }


        stage("allure report") {
            steps {
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh "scp -i /root/.keys/custom_${params.user_name}_key -r root@${params.Ambari_server_IP}:/home/hdfs/complete-result ."
                }
                }
            }
        }


