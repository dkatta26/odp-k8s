                            //sh "cd playbooks/ && ansible-playbook spark3_playbook.yml -i ../${params.user_name}_server --extra-vars 'cluster_name=${params.cluster_name}'"

                        }
                        if (params.Python.contains('3')) {

                            sh "echo using python3 command"
                            sh "virtualenv -p /usr/bin/python3 ~/ansible; source ~/ansible/bin/activate && cd playbooks/ && ansible-playbook tpcds_playbook.yml -i ../${params.user_name}_server --extra-vars 'data_type=${params.data_type} data_size=${params.data_size} krb=${params.KERBEROS}'"

