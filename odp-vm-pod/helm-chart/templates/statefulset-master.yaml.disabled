apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ .Values.clusterName }}-master
  labels:
    app: odp-cluster
    cluster: {{ .Values.clusterName }}
    role: master
spec:
  serviceName: {{ .Values.clusterName }}-headless
  replicas: {{ .Values.nodes.master.count }}
  selector:
    matchLabels:
      app: odp-cluster
      cluster: {{ .Values.clusterName }}
      role: master
  template:
    metadata:
      labels:
        app: odp-cluster
        cluster: {{ .Values.clusterName }}
        role: master
    spec:
      # Required for systemd
      securityContext:
        {{- toYaml .Values.securityContext | nindent 8 }}

      containers:
      - name: odp-node
        image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
        imagePullPolicy: {{ .Values.image.pullPolicy }}

        # Environment variables for initialization
        env:
        - name: NODE_TYPE
          value: "master"
        - name: CLUSTER_NAME
          value: {{ .Values.clusterName }}
        - name: NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: NODE_INDEX
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: ODP_REPO_URL
          value: {{ .Values.odpConfig.odpRepoUrl }}
        - name: AMBARI_REPO_URL
          value: {{ .Values.odpConfig.ambariRepoUrl }}

        # Resources
        resources:
          {{- toYaml .Values.nodes.master.resources | nindent 10 }}

        # Ports
        ports:
        - name: ssh
          containerPort: 22
        - name: ambari-web
          containerPort: 8080
        - name: namenode-web
          containerPort: 9870
        - name: namenode-rpc
          containerPort: 8020
        - name: yarn-rm-web
          containerPort: 8088
        - name: zookeeper
          containerPort: 2181

        # Volume mounts
        volumeMounts:
        - name: data
          mountPath: /hadoop
        - name: logs
          mountPath: /var/log
        - name: systemd-cgroup
          mountPath: /sys/fs/cgroup
          readOnly: true

        # Liveness probe - check if systemd is running
        livenessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - systemctl is-system-running || test $? -eq 1
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 10

        # Readiness probe - check if Ambari Server is ready
        readinessProbe:
          tcpSocket:
            port: 8080
          initialDelaySeconds: 120
          periodSeconds: 15
          timeoutSeconds: 5

      # Volumes
      volumes:
      - name: systemd-cgroup
        hostPath:
          path: /sys/fs/cgroup
          type: Directory

  # Volume claim templates for persistent storage
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes: [ "ReadWriteOnce" ]
      {{- if .Values.nodes.master.storage.storageClass }}
      storageClassName: {{ .Values.nodes.master.storage.storageClass }}
      {{- end }}
      resources:
        requests:
          storage: {{ .Values.nodes.master.storage.size }}
  - metadata:
      name: logs
    spec:
      accessModes: [ "ReadWriteOnce" ]
      {{- if .Values.nodes.master.storage.storageClass }}
      storageClassName: {{ .Values.nodes.master.storage.storageClass }}
      {{- end }}
      resources:
        requests:
          storage: 10Gi
