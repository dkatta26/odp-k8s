# ODP "VM-as-Pod" Image - Parameterized
# Supports multiple OS, Java, and ODP versions

# Base OS selection via build arg
ARG BASE_OS=rockylinux:9
FROM ${BASE_OS}

LABEL maintainer="Acceldata <support@acceldata.io>"

# Build arguments for version control
ARG OS_TYPE=rhel9
ARG ODP_VERSION=3.3.6.3-1
ARG AMBARI_VERSION=2.7.6.0-1
ARG JAVA_VERSION=jdk11
ARG PYTHON_VERSION=3.11
ARG ODP_REPO_URL=https://mirror.odp.acceldata.dev/ODP/centos/${ODP_VERSION}/
ARG AMBARI_REPO_URL=https://mirror.odp.acceldata.dev/AMBARI/centos/${AMBARI_VERSION}/
ARG ZING_JDK_URL=""

LABEL odp.version="${ODP_VERSION}" \
      java.version="${JAVA_VERSION}" \
      os.type="${OS_TYPE}" \
      python.version="${PYTHON_VERSION}"

# Install systemd and basic tools
RUN if [ "$OS_TYPE" = "centos7" ]; then \
      yum install -y systemd systemd-sysv initscripts; \
    elif [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
      apt-get update && apt-get install -y systemd systemd-sysv; \
    else \
      dnf install -y systemd systemd-sysv initscripts; \
    fi

# Install Java based on version
RUN if [ "$JAVA_VERSION" = "jdk8" ]; then \
      if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
        apt-get install -y openjdk-8-jdk; \
        export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64; \
      else \
        yum install -y java-1.8.0-openjdk-devel || dnf install -y java-1.8.0-openjdk-devel; \
        export JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk; \
      fi; \
    elif [ "$JAVA_VERSION" = "jdk11" ]; then \
      if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
        apt-get install -y openjdk-11-jdk; \
        export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64; \
      else \
        yum install -y java-11-openjdk-devel || dnf install -y java-11-openjdk-devel; \
        export JAVA_HOME=/usr/lib/jvm/java-11-openjdk; \
      fi; \
    elif [ "$JAVA_VERSION" = "jdk17" ]; then \
      if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
        apt-get install -y openjdk-17-jdk; \
        export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64; \
      else \
        yum install -y java-17-openjdk-devel || dnf install -y java-17-openjdk-devel; \
        export JAVA_HOME=/usr/lib/jvm/java-17-openjdk; \
      fi; \
    elif [ "$JAVA_VERSION" = "zingjdk8" ] || [ "$JAVA_VERSION" = "zingjdk11" ] || [ "$JAVA_VERSION" = "zingjdk17" ]; then \
      mkdir -p /opt/zing && cd /opt/zing && \
      wget -q "${ZING_JDK_URL}" -O zing.tar.gz && \
      tar -xzf zing.tar.gz && \
      rm zing.tar.gz && \
      ln -s /opt/zing/zing* /opt/zing/current && \
      export JAVA_HOME=/opt/zing/current; \
    fi

# Set Java environment
ENV JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-11-openjdk} \
    PATH=$PATH:${JAVA_HOME}/bin

# Install Python based on version
RUN if [ "$OS_TYPE" = "centos7" ] && [ "$PYTHON_VERSION" = "2" ]; then \
      yum install -y python2 python2-pip; \
    elif [ "$PYTHON_VERSION" = "3.11" ] || [ "$PYTHON_VERSION" = "311" ]; then \
      if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
        apt-get install -y python3.11 python3.11-dev python3-pip; \
      else \
        dnf install -y python3.11 python3.11-devel python3-pip; \
      fi; \
      update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 || true; \
    else \
      if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
        apt-get install -y python3 python3-dev python3-pip; \
      else \
        yum install -y python3 python3-devel python3-pip || dnf install -y python3 python3-devel python3-pip; \
      fi; \
    fi

# Install common packages based on OS
RUN if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
      apt-get install -y \
        openssh-server wget curl tar gzip net-tools \
        iproute2 dnsutils netcat vim sudo cron rsync; \
    else \
      if [ "$OS_TYPE" = "centos7" ]; then \
        yum install -y \
          openssh-server openssh-clients wget curl tar gzip \
          net-tools iproute bind-utils nc vim sudo cronie rsync; \
      else \
        dnf install -y \
          openssh-server openssh-clients wget curl tar gzip \
          net-tools iproute bind-utils nc vim sudo cronie rsync; \
      fi; \
    fi

# Remove unnecessary systemd services
RUN (cd /lib/systemd/system/sysinit.target.wants/; for i in *; do [ $i == systemd-tmpfiles-setup.service ] || rm -f $i; done); \
    rm -f /lib/systemd/system/multi-user.target.wants/*;\
    rm -f /etc/systemd/system/*.wants/*;\
    rm -f /lib/systemd/system/local-fs.target.wants/*; \
    rm -f /lib/systemd/system/sockets.target.wants/*udev*; \
    rm -f /lib/systemd/system/sockets.target.wants/*initctl*; \
    rm -f /lib/systemd/system/basic.target.wants/*;\
    rm -f /lib/systemd/system/anaconda.target.wants/*;

# Copy and run repository setup script
COPY scripts/setup-repos.sh /tmp/setup-repos.sh
RUN chmod +x /tmp/setup-repos.sh && \
    ODP_REPO_URL="${ODP_REPO_URL}" \
    AMBARI_REPO_URL="${AMBARI_REPO_URL}" \
    OS_TYPE="${OS_TYPE}" \
    /tmp/setup-repos.sh

# Install ODP and Ambari packages
RUN if [ "$OS_TYPE" = "ubuntu20" ] || [ "$OS_TYPE" = "ubuntu22" ]; then \
      apt-get update && \
      apt-get install -y ambari-server ambari-agent \
        hadoop hadoop-hdfs hadoop-yarn hadoop-mapreduce \
        hive hive-metastore hive-server2 hbase zookeeper kafka spark3; \
    else \
      if [ "$OS_TYPE" = "centos7" ]; then \
        yum install -y ambari-server ambari-agent \
          hadoop hadoop-hdfs hadoop-yarn hadoop-mapreduce \
          hive hive-metastore hive-server2 hbase zookeeper kafka spark3; \
      else \
        dnf install -y ambari-server ambari-agent \
          hadoop hadoop-hdfs hadoop-yarn hadoop-mapreduce \
          hive hive-metastore hive-server2 hbase zookeeper kafka spark3; \
      fi; \
    fi

# Create ODP directories
RUN mkdir -p \
    /hadoop/hdfs/namenode /hadoop/hdfs/datanode \
    /hadoop/yarn/local /hadoop/yarn/logs \
    /var/log/hadoop /var/log/ambari-server /var/log/ambari-agent \
    /var/log/hive /var/log/hbase /var/log/zookeeper /var/log/kafka \
    && chmod -R 755 /hadoop /var/log

# Copy initialization and service files
COPY scripts/init-odp-node.sh /usr/local/bin/init-odp-node.sh
COPY systemd-services/*.service /etc/systemd/system/ 2>/dev/null || true
COPY configs/ /opt/odp-configs/ 2>/dev/null || true

RUN chmod +x /usr/local/bin/init-odp-node.sh && \
    systemctl enable sshd && \
    systemctl enable ambari-server && \
    systemctl enable ambari-agent

# Expose ports
EXPOSE 22 8080 8020 9870 9864 9866 8088 8042 10000 16000 16010 2181 9092

# Persistent volumes
VOLUME ["/hadoop", "/var/log", "/etc/hadoop", "/etc/hive", "/etc/hbase"]

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
